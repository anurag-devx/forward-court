# Forward Court configuration. Copy to .env and fill in.
# Only MODEL_API_KEY is required. Everything else is optional and off
# by default.

# Required: Meta Model API key (agents, judge, grounding, vision, video).
MODEL_API_KEY=

# Contributor model: on by default; set to 0/false/no/off for standard.
FC_CONTRIBUTOR=1

# Reverse image search (SerpAPI Google Lens). Built but disabled for the
# hackathon per the runtime-model rule; leave off.
REVERSE_SEARCH=off
SERPAPI_KEY=

# Google Safe Browsing link reputation. Built but its use could not be
# confirmed for the hackathon; leave off.
GSB=off
GSB_API_KEY=

# WhatsApp gateway (optional): twilio or vonage.
WHATSAPP_PROVIDER=twilio
PUBLIC_BASE_URL=

# Twilio sender (optional).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Vonage Messages API Sandbox sender (optional).
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_WHATSAPP_NUMBER=
# Signed webhooks: set VONAGE_SIGNATURE_SECRET, or use the ?t= gate instead.
VONAGE_SIGNATURE_SECRET=
VONAGE_WEBHOOK_TOKEN=
